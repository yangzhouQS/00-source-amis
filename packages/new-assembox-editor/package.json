{
  "name": "@cs/assembox-editor-next",
  "version": "0.1.0",
  "description": "新版 assembox 可视化编辑器（声明式插件系统 / 响应式 Store / 标准化画布）",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@cs/element-plus-ui": "^1.1.0",
    "@cs/assembox-core-next": "workspace:*",
    "@cs/assembox-desktop-next": "workspace:*",
    "@element-plus/icons-vue": "^2.3.2",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@cs/vue3-biz-components-library": "0.2.0",
    "@cs/js-web-framework": "^1.2.0",
    "element-plus": "^2.13.7",
    "monaco-editor": "^0.56.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@cs/js-eslint-config-library": "0.2.7",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "less": "^4.9.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "element-plus": "^2.13.0",
    "vue": "^3.5.0"
  }
}
