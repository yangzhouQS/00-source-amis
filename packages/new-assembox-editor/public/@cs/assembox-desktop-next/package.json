{
  "name": "@cs/assembox-desktop-next",
  "version": "0.1.0",
  "description": "Assembox 低代码平台桌面端渲染库（重构版）",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build:types": "tsc",
    "build:vite": "vite build",
    "build": "pnpm build:types && pnpm build:vite",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "element-plus": "^2.7.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@cs/assembox-core-next": "workspace:*",
    "@cs/vue3-biz-components-library": "^0.1.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.0",
    "decimal.js": "^10.6.0",
    "jsdom": "^29.0.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC"
}