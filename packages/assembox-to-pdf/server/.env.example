# 导出服务配置（复制为 .env 或直接使用默认值）
PORT=9100
# 渲染用 Chromium 可执行文件：默认自动探测 /usr/bin/google-chrome 等
CHROMIUM_EXECUTABLE_PATH=
# 打印宿主页静态产物目录（vite build 输出）
PRINT_HOST_DIST=../print-host/dist
# 场景配置目录（json-config）
SCENES_DIR=../../json-config
# PDF 产物目录
EXPORTS_DIR=./data/exports
# 浏览器池：并发上下文数 / 队列上限 / 任务硬超时
POOL_CONTEXTS=3
QUEUE_MAX=50
TASK_TIMEOUT_MS=30000
# 票据 TTL（一次性消费）
TICKET_TTL_MS=60000
# 浏览器轮换阈值（任务数）
BROWSER_RECYCLE_AFTER=500
# 同步导出等待池槽位的超时
SYNC_ACQUIRE_TIMEOUT_MS=15000
